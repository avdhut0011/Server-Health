# Environment Configuration Example
APP_NAME=Server Health Monitoring Platform
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

# Security & Authentication
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Custom Application Database (PostgreSQL / SQLite for development)
DATABASE_URL=sqlite+aiosqlite:///./server_health.db
SYNC_DATABASE_URL=sqlite:///./server_health.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql+asyncpg://shm_user:shm_password@localhost:5432/server_health_db
# SYNC_DATABASE_URL=postgresql://shm_user:shm_password@localhost:5432/server_health_db

# Zabbix Server Core Integration
ZABBIX_URL=http://localhost:8080/api_jsonrpc.php
ZABBIX_USERNAME=Admin
ZABBIX_PASSWORD=zabbix
# ZABBIX_API_TOKEN=your_zabbix_api_token_here
ZABBIX_TIMEOUT=10
ZABBIX_VERIFY_SSL=False
ZABBIX_SYNC_INTERVAL_SECONDS=10

# Thresholds & Availability
CONSECUTIVE_FAILURES_FOR_DOWN=3
CPU_WARNING_THRESHOLD=70.0
CPU_CRITICAL_THRESHOLD=90.0
MEMORY_WARNING_THRESHOLD=80.0
MEMORY_CRITICAL_THRESHOLD=95.0
DISK_WARNING_THRESHOLD=80.0
DISK_CRITICAL_THRESHOLD=90.0

# Generic SMTP Email Dispatch
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=alerts@datacenter.local
SMTP_PASSWORD=your_smtp_password
SMTP_TLS=True
SMTP_SSL=False
SMTP_SENDER=alerts@serverhealth.local
